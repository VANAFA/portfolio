rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: chat_messages
// Document ID: auto-generated
// Fields:
//   - text: string (required, 1-500 chars) - the message body. Basic
//     English/Spanish profanity is censored client-side (js/chat.js)
//     BEFORE the write - Spark plan has no Cloud Functions, so there is
//     no server-side re-check of the text content itself.
//   - authorUid: string (required, immutable) - must equal the writer's
//     own auth uid. This is the one identity fact these rules truly
//     guarantee; authorName below is not.
//   - authorName: string (required, 1-24 chars) - the display name shown
//     next to the message. NOT cross-checked against the account's real
//     display name (avoids a signup race where a fresh ID token hasn't
//     picked up the profile update yet), so treat it as flavor text, not
//     a verified identity claim - authorUid is the real identity.
//   - createdAt: timestamp (required, immutable) - must equal the
//     server's request time, so clients can't back- or post-date messages.
// Messages are permanent once posted: no update or delete from clients.
//
// Collection: leaderboard_scores
// Document ID: "<game>_<name, trimmed+lowercased>" (js/leaderboard.js derives
//   this) - one document per name per game, not auto-generated, so a player
//   beating their own previous score overwrites the same slot instead of
//   piling up a new entry. There's no account system to key this off
//   instead, so two different people who happen to type the same name for
//   the same game share a slot and only the better of their scores
//   survives - an accepted quirk of the same "no login, arcade cabinet"
//   trust model as the name field itself.
// Fields:
//   - game: string (required, immutable) - one of the enum values below.
//     Minesweeper's three difficulties and Solitaire each get their own
//     leaderboard bucket.
//   - name: string (required, 1-20 chars) - free-text name the player
//     types in, arcade-high-score style. No account/auth involved, so
//     this is unverified flavor text like a Chat authorName, not identity.
//   - value: number (required, integer, > 0) - lower is better for
//     Minesweeper (seconds elapsed) and Solitaire (moves made), capped at
//     99999; higher is better for Pinball (points), capped at 999999999.
//     Pinball is a custom rebuild of alula/SpaceCadetPinball (see
//     pinball/index.html) with two exported functions added to the
//     upstream engine specifically so the value can be read straight out
//     of the game's own memory when a game ends, the same trust level as
//     the other three games - not self-reported. These bounds are still
//     just an anti-garbage/DoS sanity check, same as the others.
//   - createdAt: timestamp (required, immutable per write) - must equal the
//     server's request time, so it reflects when this document's current
//     (best-so-far) value was actually set.
// No login required to submit a score - same trust level as a real arcade
// cabinet's 3-letter initials entry. The value bounds below are the only
// defense against a garbage/DoS submission. An existing document can only
// be overwritten with a strictly better value (see isValidScore/allow
// update below) - that's what makes an old record disappear once beaten,
// and stops anyone from overwriting a good score with a worse one.
//
// Collection: presence
// Document ID: a random id the client generates itself (js/presence.js),
//   one per open tab - the MSN chat window's "N online" counter.
// Fields:
//   - lastSeen: timestamp (required) - refreshed by a ~20s heartbeat while
//     the tab is visible; must equal the server's request time.
// See the match block below for the full rationale (no Realtime Database on
// the Spark plan, so this approximates presence with an aged-out heartbeat
// instead of true online/offline tracking).
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidChatMessage(data) {
      return hasOnlyAllowedFields(['text', 'authorUid', 'authorName', 'createdAt']) &&
        hasRequiredFields(['text', 'authorUid', 'authorName', 'createdAt']) &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 500 &&
        data.authorUid is string && data.authorUid == request.auth.uid &&
        data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 24 &&
        data.createdAt == request.time;
    }

    // ===============================================================
    // chat_messages - public read (this is meant to be an open chat
    // anyone can read without an account), write requires a signed-in,
    // email-verified user posting under their own uid. No edits or
    // deletes once posted.
    // ===============================================================
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if isVerified() && isValidChatMessage(request.resource.data);
      allow update, delete: if false;
    }

    function isValidScore(data) {
      let validGames = ['minesweeper-beginner', 'minesweeper-intermediate', 'minesweeper-expert', 'solitaire', 'pinball'];
      let maxValue = data.game == 'pinball' ? 999999999 : 99999;
      return hasOnlyAllowedFields(['game', 'name', 'value', 'createdAt']) &&
        hasRequiredFields(['game', 'name', 'value', 'createdAt']) &&
        data.game is string && data.game in validGames &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 20 &&
        data.value is number && data.value > 0 && data.value <= maxValue &&
        data.createdAt == request.time;
    }

    // Pinball is the one game here where a higher value is the better one.
    function isScoreImprovement(newData, oldData) {
      return newData.game == 'pinball' ? newData.value > oldData.value : newData.value < oldData.value;
    }

    // leaderboard_scores - public read and create (no account needed, like
    // typing initials into an arcade cabinet). An existing entry can only be
    // updated to a strictly better value for the same game - that's the
    // entire "beat your record and the old one disappears" mechanism, since
    // js/leaderboard.js reuses the same document ID for the same name+game
    // rather than always creating a new document. No deletes.
    match /leaderboard_scores/{scoreId} {
      allow read: if true;
      allow create: if isValidScore(request.resource.data);
      allow update: if isValidScore(request.resource.data) &&
        request.resource.data.game == resource.data.game &&
        isScoreImprovement(request.resource.data, resource.data);
      allow delete: if false;
    }

    function isValidPresence(data) {
      return hasOnlyAllowedFields(['lastSeen']) &&
        hasRequiredFields(['lastSeen']) &&
        data.lastSeen == request.time;
    }

    // presence - the MSN chat window's "N online" counter (js/presence.js).
    // Document ID: a random id the client generates itself (crypto.randomUUID,
    //   kept in sessionStorage) - one document per open tab, not per person.
    //   Spark plan has no Realtime Database/Cloud Functions for real
    //   presence, so this is a plain heartbeat write every ~20s; the client
    //   only counts documents whose lastSeen is within the last ~75s, aging
    //   a closed/backgrounded tab out of the count itself rather than
    //   needing a server-side expiry.
    // Fields:
    //   - lastSeen: timestamp (required) - must equal the server's request
    //     time, so a client can't fake a fresher heartbeat than it just sent.
    // No login required - same trust level as a leaderboard name. A griefer
    // could hammer this with junk heartbeats, but the worst outcome is a
    // wrong-looking online count, nothing sensitive. Documents are never
    // deleted (no scheduled Cloud Function on Spark to expire them); at any
    // realistic traffic for this site, total storage here stays far under
    // Firestore's free quota for years.
    match /presence/{sessionId} {
      allow read: if true;
      allow create, update: if isValidPresence(request.resource.data);
      allow delete: if false;
    }

    // Default deny for anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
